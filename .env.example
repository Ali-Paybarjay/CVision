# Copy this file to .env.local and fill in the values. Never commit .env.local.

# AI: "mock" (default) sends no requests and returns sample answers.
# "live" calls the Claude API and needs ANTHROPIC_API_KEY. The shared key lives only on Vercel.
AI_MODE=mock
ANTHROPIC_API_KEY=
# Optional: override the default model (claude-haiku-5-5).
# AI_MODEL=

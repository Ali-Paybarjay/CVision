# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- AI ---
# "mock" (default) sends no requests and returns sample answers.
# "live" calls Claude and needs one of the two keys below. The shared key lives only on Vercel.
AI_MODE=mock
# Straight from Anthropic. Used first when both keys are set.
ANTHROPIC_API_KEY=
# Or the same Claude models through OpenRouter (https://openrouter.ai).
OPENROUTER_API_KEY=
# Optional: override the default model (claude-haiku-5-5). Use Anthropic's names; askModel renames them for OpenRouter.
# AI_MODEL=

# Daily limits on real model requests (live mode only).
# AI_DAILY_LIMIT_PER_USER=40
# AI_DAILY_LIMIT_PER_ANONYMOUS=3
# AI_DAILY_LIMIT_ALL_ANONYMOUS=300

# --- Supabase ---
# Without these the app still runs: sign-in shows a notice and usage stays in memory.
# Safe in the browser (row-level security protects the data):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only, never NEXT_PUBLIC_. Bypasses row-level security: only Ali and Vercel hold it.
SUPABASE_SECRET_KEY=

# A long random string, so anonymous visitor keys cannot be traced back to an IP address.
# ANONYMOUS_KEY_SALT=
